# Local configuration for the voice assistant.
# This file is git-ignored (.gitignore) - never commit it.

# === Required ==============================================================
ELEVENLABS_API_KEY=sk_c1eccac3889dd0fc8a1d257ea316d936341d203a2b4959be

# === Speech recognition (ElevenLabs Scribe) ================================
STT_MODEL_ID=scribe_v2
STT_MODE=batch
STT_LANGUAGE_CODE=
STT_NO_VERBATIM=false
STT_KEYTERMS=

# === Text to speech (ElevenLabs) ===========================================
TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
TTS_MODEL_ID=eleven_turbo_v2_5
TTS_OUTPUT_FORMAT=pcm_24000
TTS_STABILITY=0.5
TTS_SIMILARITY_BOOST=0.75
TTS_STYLE=0.0
TTS_SPEAKER_BOOST=true
TTS_SPEED=1.0

# === Audio devices / capture ===============================================
# Leave blank for system defaults; see: --list-devices
INPUT_DEVICE=
OUTPUT_DEVICE=
SAMPLE_RATE=16000
VAD_THRESHOLD_FACTOR=2.5
VAD_MIN_THRESHOLD=0.01
SILENCE_DURATION=0.8
MIN_SPEECH_DURATION=0.25
MAX_RECORD_SECONDS=20.0
LISTEN_TIMEOUT=
ECHO_GUARD=true

# === Response generation (LLM) =============================================
# auto = OpenAI key if set, else the ElevenLabs agent (if configured), else offline.
LLM_PROVIDER=auto
# Optional OpenAI-compatible key. Leave blank to answer via the ElevenLabs
# agent configured below (uses the agent's own language model).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=400
LLM_TIMEOUT=30.0

# === Conversation ==========================================================
ASSISTANT_NAME=Aria
SYSTEM_PROMPT=
MAX_HISTORY_TURNS=12
LOG_TRANSCRIPTS=false

# === ElevenLabs Agents mode (optional) =====================================
# Create an agent at https://elevenlabs.io/app/conversational-ai, then run:
#   python -m voice_assistant.cli --mode agents
ELEVENLABS_AGENT_ID=agent_9501m4qvsp4ffy1ax6tecdqy2mzv
# Set to true when the agent is public (authentication disabled in the agent's
# settings). Public agents connect with just the agent_id, so no signed URL --
# and therefore no convai_write permission on the API key -- is required.
ELEVENLABS_AGENT_PUBLIC=true
