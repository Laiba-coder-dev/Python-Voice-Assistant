# ---------------------------------------------------------------------------
# Voice Assistant - sample configuration
#
# Copy this file to ".env" and fill in your values:
#     cp .env.example .env          # macOS / Linux
#     copy .env.example .env        # Windows (cmd / PowerShell)
#
# The ".env" file is git-ignored and must never be committed. Only real
# environment variables override values set here.
# ---------------------------------------------------------------------------

# === Required ==============================================================
# Your ElevenLabs API key (https://elevenlabs.io/app/developers/api-keys).
# Used for BOTH speech recognition and speech synthesis.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# === Speech recognition (ElevenLabs Scribe) ================================
# Model id: scribe_v2 (recommended) or scribe_v1.
STT_MODEL_ID=scribe_v2
# "batch" (reliable, default) or "realtime" (streaming, lower latency).
# realtime uses the Scribe realtime WebSocket endpoint with server VAD.
STT_MODE=batch
# ISO-639-3 language code to force a language, e.g. "eng". Leave blank for
# automatic detection.
STT_LANGUAGE_CODE=
# Set to true to keep filler words ("um", "uh"); false cleans them up.
STT_NO_VERBATIM=false
# Optional comma-separated hints for names/jargon, e.g. "OpenCode,Kubernetes".
STT_KEYTERMS=

# === Text to speech (ElevenLabs) ===========================================
# Find voice ids in the ElevenLabs dashboard or run: --list-voices
TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_turbo_v2_5 (fast), eleven_flash_v2_5, eleven_multilingual_v2, eleven_v3
TTS_MODEL_ID=eleven_turbo_v2_5
# pcm_24000 streams raw PCM directly to the speakers. Other examples:
# mp3_44100_128, pcm_16000, ulaw_8000.
TTS_OUTPUT_FORMAT=pcm_24000
# Voice character - all values are 0.0 .. 1.0 (speed is 0.7 .. 1.2).
TTS_STABILITY=0.5
TTS_SIMILARITY_BOOST=0.75
TTS_STYLE=0.0
TTS_SPEAKER_BOOST=true
TTS_SPEED=1.0

# === Audio devices / capture ===============================================
# Device indexes from: python -m voice_assistant.cli --list-devices
# Leave blank to use the system defaults.
INPUT_DEVICE=
OUTPUT_DEVICE=
# Microphone capture sample rate (Hz). 16000 is recommended for speech.
SAMPLE_RATE=16000
# Voice-activity detection tuning.
VAD_THRESHOLD_FACTOR=2.5
VAD_MIN_THRESHOLD=0.01
# Seconds of silence that ends an utterance.
SILENCE_DURATION=0.8
# Ignore blips shorter than this (seconds).
MIN_SPEECH_DURATION=0.25
# Hard cap on a single recording (seconds).
MAX_RECORD_SECONDS=20.0
# Stop listening after N seconds of silence (blank = wait forever).
LISTEN_TIMEOUT=
# Ignore transcripts that look like the assistant's own voice (anti-echo).
ECHO_GUARD=true

# === Response generation (LLM) =============================================
# auto  = OpenAI key if set, else the ElevenLabs agent, else the offline fallback
# openai = OpenAI-compatible Chat Completions endpoint
# elevenlabs = use an ElevenLabs Agent's built-in language model (needs
#              ELEVENLABS_AGENT_ID below)
# offline = built-in rule-based responder (no key, no network)
LLM_PROVIDER=auto
# Any OpenAI-compatible key. OPENAI_API_KEY is accepted as an alias.
LLM_API_KEY=
# Point at OpenAI, Azure, Groq, Ollama, LM Studio, OpenRouter, etc.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=400
LLM_TIMEOUT=30.0

# === Conversation ==========================================================
ASSISTANT_NAME=Aria
# Optional persona override. Leave blank to use the built-in voice prompt.
SYSTEM_PROMPT=
# How many user/assistant exchange pairs to keep as context.
MAX_HISTORY_TURNS=12
# Log transcribed/assistant text to the console (may contain private data).
LOG_TRANSCRIPTS=false

# === ElevenLabs Agents mode (optional) =====================================
# Only needed for: python -m voice_assistant.cli --mode agents
ELEVENLABS_AGENT_ID=
# Set to true when the agent is public (authentication disabled in the agent's
# Advanced/Security settings). A public agent connects with just its agent_id,
# so no signed URL and no convai_write permission are needed. When false, the
# app mints a signed URL instead (requires convai_write on the API key).
ELEVENLABS_AGENT_PUBLIC=false

# === Logging ===============================================================
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=WARNING
